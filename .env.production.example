# ===========================================
# KDIGIT — Variables de production (Vercel)
# Copier chaque variable dans Vercel → Settings → Environment Variables
# ===========================================

# PostgreSQL (Neon ou Supabase — connection string avec ?sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/kdigit?sslmode=require"

# Auth — Générer une NOUVELLE clé pour la production !
JWT_SECRET="GENERER_UNE_CLE_ALEATOIRE_64_CARACTERES"

# Email SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="contact@kdigit.com"
SMTP_PASS="mot-de-passe-application-smtp"
SMTP_FROM="KDIGIT <contact@kdigit.com>"
ADMIN_EMAIL="admin@kdigit.com"

# Site
NEXT_PUBLIC_SITE_URL="https://kdigit.com"
NEXT_PUBLIC_WHATSAPP_NUMBER="2250708967624"

# Anti-spam
CONTACT_RATE_LIMIT_PER_HOUR="10"

# Node
NODE_ENV="production"
