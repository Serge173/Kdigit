# ===========================================
# KDIGIT — Configuration locale (développement)
# Copier ce fichier : cp .env.example .env
# ===========================================

# PostgreSQL local OU Neon/Supabase (ajouter ?sslmode=require pour le cloud)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kdigit?schema=public"
# En local, identique à DATABASE_URL. En prod Neon : connexion directe (sans -pooler)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/kdigit?schema=public"
DATABASE_URL_NON_POOLING="postgresql://postgres:postgres@localhost:5432/kdigit?schema=public"

# Auth — Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-this-to-a-long-random-secret-key"

# Email SMTP (Gmail, Brevo, SendGrid...)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="contact@kdigit.com"
SMTP_PASS=""
SMTP_FROM="KDIGIT <contact@kdigit.com>"
ADMIN_EMAIL="Skeayeni@gmail.com"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="2250708967624"

# Notification WhatsApp admin (optionnel — voir DEPLOYMENT.md)
# Numéro qui reçoit les alertes devis (sans +)
WHATSAPP_NOTIFY_NUMBER="2250708967624"
# Option 1 : WhatsApp Cloud API (Meta Business)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Option 2 : CallMeBot (gratuit) — https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_API_KEY=""

# Anti-spam
CONTACT_RATE_LIMIT_PER_HOUR="10"
QUOTE_RATE_LIMIT_PER_HOUR="5"
LOGIN_RATE_LIMIT_PER_HOUR="20"

# Node
NODE_ENV="development"
